							{
								"type": "message",
								"value": "Extra small · no Bootstrap infix (default size)"
							},
							{
								"type": "group",
								"title": "Padding",
								"initialOpen": true,
								"attributes": [
									{
										"id": "padding_top_xs",
										"type": "text",
										"label": "Padding top",
										"help": "Number without a unit. The unit is a plugin setting, pixels by default. Leave empty for no spacing; enter 0 to force a zero value."
									},
									{
										"id": "padding_right_xs",
										"type": "text",
										"label": "Padding right",
										"help": "Number without a unit. The unit is a plugin setting, pixels by default."
									},
									{
										"id": "padding_bottom_xs",
										"type": "text",
										"label": "Padding bottom",
										"help": "Number without a unit. The unit is a plugin setting, pixels by default."
