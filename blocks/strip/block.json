{
	"$schema": "https://blockstudio.dev/schema/block",
	"apiVersion": 2,
	"name": "creabb/strip",
	"title": "Strip",
	"category": "creabb-layout",
	"description": "Full width strip allowing background colors, images and videos.",
	"icon": "minus",
	"keywords": [
		"areoi",
		"creabb",
		"bootstrap",
		"layout",
		"strip"
	],
	"textdomain": "crea-bootstrap-blocks",
