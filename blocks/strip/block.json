							{
								"type": "group",
								"title": "Background at this breakpoint",
								"initialOpen": false,
								"attributes": [
									{
										"id": "background_hide_xs",
										"type": "toggle",
										"label": "Hide background at this breakpoint",
										"help": "Hides the background layer of this block at this breakpoint and restores it at the next visible one."
									},
									{
										"id": "background_col_xs",
										"type": "creabb/select",
										"label": "Background columns",
										"help": "Width of the grid column that carries the background layer.",
