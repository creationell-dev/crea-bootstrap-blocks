#: includes/i18n-strings.php:605
msgid "Carousel"
msgstr "Karussell"

#: includes/i18n-strings.php:606
msgid "A slideshow component for cycling through elements — images or slides of text — like a carousel."
msgstr "Eine Diaschau, die Elemente der Reihe nach einblendet, etwa Bilder oder Textfolien."

#: includes/i18n-strings.php:607
msgid "Display Controls"
msgstr "Steuerung anzeigen"

#: includes/i18n-strings.php:608
msgid "Show the previous and next buttons."
msgstr "Blendet die Knoepfe fuer vorwaerts und rueckwaerts ein."

#: includes/i18n-strings.php:609
msgid "Display Indicators"
msgstr "Indikatoren anzeigen"

#: includes/i18n-strings.php:610
msgid "Show the slide indicators below the carousel."
msgstr "Blendet die Folienindikatoren unterhalb des Karussells ein."

#: includes/i18n-strings.php:611
msgid "Touch Enabled"
msgstr "Wischgesten erlauben"

#: includes/i18n-strings.php:612
msgid "Allow swiping left and right on touch devices."
msgstr "Ermoeglicht Wischgesten nach links und rechts auf Touchgeraeten."

#: includes/i18n-strings.php:613
msgid "Pause"
msgstr "Pausieren"

#: includes/i18n-strings.php:614
msgid "Choose whether the carousel pauses when the pointer hovers over it."
msgstr "Bestimmen Sie, ob das Karussell pausiert, solange der Zeiger darauf ruht."

#: includes/i18n-strings.php:615
msgid "False"
msgstr "Nein"

#: includes/i18n-strings.php:616
msgid "Auto Scroll"
msgstr "Automatisch weiterschalten"

#: includes/i18n-strings.php:617
msgid "Cycle through the slides automatically."
msgstr "Wechselt die Folien selbsttaetig."

#: includes/i18n-strings.php:618
msgid "Auto Scroll Interval"
msgstr "Intervall"

#: includes/i18n-strings.php:619
msgid "Time in milliseconds between two slides."
msgstr "Abstand in Millisekunden zwischen zwei Folien."

#: includes/i18n-strings.php:620
msgid "Choose the colour scheme of the carousel controls and indicators."
msgstr "Bestimmen Sie das Farbschema von Steuerung und Indikatoren."

#: includes/i18n-strings.php:621
msgid "Transition"
msgstr "Uebergang"

#: includes/i18n-strings.php:622
msgid "Choose how one slide is replaced by the next."
msgstr "Bestimmen Sie, wie eine Folie in die naechste uebergeht."

#: includes/i18n-strings.php:623
msgid "Crossfade"
msgstr "Ueberblenden"

#: includes/i18n-strings.php:624
msgid "Carousel Item"
msgstr "Karussellfolie"

#: includes/i18n-strings.php:625
msgid "A single slide within a carousel."
msgstr "Eine einzelne Folie innerhalb eines Karussells."

#: includes/i18n-strings.php:626
msgid "Interval"
msgstr "Intervall"

#: includes/i18n-strings.php:627
msgid "Time in milliseconds this slide is shown before the next one."
msgstr "Dauer in Millisekunden, die diese Folie sichtbar bleibt, bevor die naechste folgt."

#: includes/i18n-strings.php:628
msgid "Progress"
msgstr "Fortschritt"

#: includes/i18n-strings.php:629
msgid "Document the progress of a task or an action with a progress bar."
msgstr "Stellen Sie den Fortschritt einer Aufgabe oder Aktion als Balken dar."

#: includes/i18n-strings.php:630
msgid "Width"
msgstr "Breite"

#: includes/i18n-strings.php:631
msgid "Width of the bar in percent."
msgstr "Breite des Balkens in Prozent."

#: includes/i18n-strings.php:632
msgid "Include Label"
msgstr "Beschriftung anzeigen"

#: includes/i18n-strings.php:633
msgid "Show the width value as text inside the bar."
msgstr "Blendet den Wert der Breite als Text im Balken ein."

#: includes/i18n-strings.php:634
msgid "Include Stripes"
msgstr "Streifen anzeigen"

#: includes/i18n-strings.php:635
msgid "Add a striped pattern to the bar."
msgstr "Ergaenzt den Balken um ein Streifenmuster."

#: includes/i18n-strings.php:636
msgid "Include Animation"
msgstr "Animation anzeigen"

#: includes/i18n-strings.php:637
msgid "Animate the striped pattern."
msgstr "Setzt das Streifenmuster in Bewegung."

#: includes/i18n-strings.php:638
msgid "Background"
msgstr "Hintergrund"

#: includes/i18n-strings.php:639
msgid "Choose the colour of the bar."
msgstr "Bestimmen Sie die Farbe des Balkens."

