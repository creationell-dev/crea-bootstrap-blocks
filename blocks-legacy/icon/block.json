            },
            {
                "type": "group",
                "title": "Settings",
                "initialOpen": true,
                "attributes": [
                    {
                        "id": "style",
                        "type": "creabb/select",
                        "label": "Style",
                        "help": "Stored colour of the icon. Kept from the previous plugin, where this block drew the icon itself; here it outputs its inner content unchanged.",
                        "options": [
                            {
                                "value": "text-primary",
                                "label": "Default"
                            },
                            {
                                "value": "text-primary",
                                "label": "Primary"
                            },
                            {
                                "value": "text-secondary",
                                "label": "Secondary"
                            },
                            {
                                "value": "text-success",
