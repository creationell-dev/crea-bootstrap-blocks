{
    "$schema": "https://blockstudio.dev/schema/block",
    "apiVersion": 2,
    "name": "areoi/icon",
    "title": "Icon",
    "category": "creabb-components",
    "description": "Display a Bootstrap icon in any of the available theme colours and sizes.",
    "icon": "star-filled",
    "keywords": [
        "areoi",
        "creabb",
        "bootstrap",
        "component"
    ],
    "textdomain": "crea-bootstrap-blocks",
    "supports": {
        "anchor": true,
        "align": false,
        "html": false,
        "inserter": false
    },
    "blockstudio": {
        "attributes": [
            {
                "id": "breakpoints",
                "type": "tabs",
                "tabs": [
                    {
                        "id": "xs",
                        "title": "XS",
                        "attributes": [
                            {
                                "type": "message",
                                "value": "Extra small · no Bootstrap infix (default size)"
                            },
                            {
                                "type": "group",
                                "title": "Alignment",
                                "initialOpen": true,
                                "attributes": [
                                    {
                                        "id": "horizontal_align_xs",
                                        "type": "creabb/select",
                                        "label": "Horizontal Align",
                                        "help": "Stored alignment for this breakpoint. This block renders no element of its own; it outputs its inner content unchanged.",
                                        "options": [
                                            {
                                                "value": "Default",
                                                "label": "Default"
                                            },
                                            {
                                                "value": "text-start",
                                                "label": "Start"
                                            },
                                            {
                                                "value": "text-center",
                                                "label": "Center"
                                            },
                                            {
                                                "value": "text-end",
                                                "label": "End"
                                            }
                                        ]
                                    }
                                ]
                            },
                            {
                                "type": "group",
                                "title": "Visibility",
                                "initialOpen": false,
                                "attributes": [
                                    {
                                        "id": "hide_xs",
                                        "type": "toggle",
                                        "label": "Hide at this breakpoint",
                                        "help": "Stored hide flag for this breakpoint. This block renders no element of its own; it outputs its inner content unchanged."
                                    }
                                ]
                            }
                        ]
                    },
