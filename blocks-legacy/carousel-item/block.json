{
    "$schema": "https://blockstudio.dev/schema/block",
    "apiVersion": 2,
    "name": "areoi/carousel-item",
    "title": "Carousel Item",
    "category": "creabb-components",
    "description": "A single slide within a carousel.",
    "icon": "images-alt2",
    "keywords": [
        "areoi",
        "creabb",
        "bootstrap",
        "component"
    ],
    "textdomain": "crea-bootstrap-blocks",
    "supports": {
        "anchor": true,
        "align": false,
        "html": false,
        "inserter": false
    },
    "blockstudio": {
        "attributes": [
            {
                "id": "breakpoints",
                "type": "tabs",
                "tabs": [
                    {
                        "id": "xs",
                        "title": "XS",
                        "attributes": [
                            {
                                "type": "message",
                                "value": "Extra small · no Bootstrap infix (default size)"
                            },
                            {
                                "type": "group",
                                "title": "Visibility",
                                "initialOpen": true,
                                "attributes": [
                                    {
                                        "id": "hide_xs",
                                        "type": "toggle",
                                        "label": "Hide at this breakpoint",
                                        "help": "Hides this block at this breakpoint and restores it at the next visible one."
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "sm",
                        "title": "SM",
                        "attributes": [
                            {
                                "type": "message",
                                "value": "Small · Bootstrap infix sm"
                            },
                            {
                                "type": "group",
                                "title": "Visibility",
                                "initialOpen": true,
                                "attributes": [
                                    {
                                        "id": "hide_sm",
                                        "type": "toggle",
                                        "label": "Hide at this breakpoint",
                                        "help": "Hides this block at this breakpoint and restores it at the next visible one."
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "md",
                        "title": "MD",
                        "attributes": [
                            {
                                "type": "message",
                                "value": "Medium · Bootstrap infix md"
                            },
                            {
                                "type": "group",
                                "title": "Visibility",
                                "initialOpen": true,
                                "attributes": [
                                    {
                                        "id": "hide_md",
                                        "type": "toggle",
                                        "label": "Hide at this breakpoint",
                                        "help": "Hides this block at this breakpoint and restores it at the next visible one."
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "lg",
                        "title": "LG",
                        "attributes": [
                            {
                                "type": "message",
                                "value": "Large · Bootstrap infix lg"
                            },
                            {
                                "type": "group",
                                "title": "Visibility",
                                "initialOpen": true,
                                "attributes": [
                                    {
                                        "id": "hide_lg",
                                        "type": "toggle",
                                        "label": "Hide at this breakpoint",
                                        "help": "Hides this block at this breakpoint and restores it at the next visible one."
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "xl",
                        "title": "XL",
                        "attributes": [
                            {
                                "type": "message",
                                "value": "Extra large · Bootstrap infix xl"
                            },
                            {
                                "type": "group",
                                "title": "Visibility",
                                "initialOpen": true,
                                "attributes": [
                                    {
                                        "id": "hide_xl",
                                        "type": "toggle",
                                        "label": "Hide at this breakpoint",
                                        "help": "Hides this block at this breakpoint and restores it at the next visible one."
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "xxl",
                        "title": "XXL",
                        "attributes": [
                            {
                                "type": "message",
                                "value": "Extra extra large · Bootstrap infix xxl"
                            },
                            {
                                "type": "group",
                                "title": "Visibility",
                                "initialOpen": true,
                                "attributes": [
                                    {
                                        "id": "hide_xxl",
                                        "type": "toggle",
                                        "label": "Hide at this breakpoint",
                                        "help": "Hides this block at this breakpoint and restores it at the next visible one."
                                    }
                                ]
                            }
                        ]
                    }
                ]
            },
            {
                "type": "group",
                "title": "Settings",
                "initialOpen": true,
                "attributes": [
                    {
                        "id": "interval",
                        "type": "text",
                        "label": "Interval",
                        "help": "Per-slide delay in milliseconds (data-bs-interval). The value is stored on the block, but neither this plugin nor the original writes it into the markup."
                    }
                ]
            },
            {
                "type": "group",
                "title": "Technical",
                "initialOpen": false,
                "attributes": [
                    {
                        "id": "block_id",
                        "type": "text",
                        "label": "Block ID",
                        "help": "Unique identifier of this block. It links the block to its generated inline CSS and must not be changed."
                    },
                    {
                        "id": "parent_id",
                        "type": "text",
                        "label": "Parent block ID",
                        "help": "Identifier of the surrounding block. It is set automatically and must not be changed."
                    }
                ]
            }
        ]
    },
    "parent": [
        "creabb/carousel",
        "areoi/carousel"
    ]
}
