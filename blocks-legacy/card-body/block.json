{
    "$schema": "https://blockstudio.dev/schema/block",
    "apiVersion": 2,
    "name": "areoi/card-body",
    "title": "Card Body",
    "category": "creabb-components",
    "parent": [
        "creabb/card",
        "areoi/card"
    ],
    "description": "The building block of a card. Use it whenever you need a padded section within a card.",
    "icon": "id-alt",
    "keywords": [
        "areoi",
        "creabb",
        "bootstrap",
        "card"
    ],
    "textdomain": "crea-bootstrap-blocks",
    "supports": {
        "anchor": true,
        "align": false,
        "html": false,
        "inserter": false
    },
    "blockstudio": {
        "attributes": [
            {
                "id": "breakpoints",
                "type": "tabs",
                "tabs": [
                    {
                        "id": "xs",
                        "title": "XS",
                        "attributes": [
                            {
                                "type": "message",
                                "value": "Extra small · no Bootstrap infix (default size)"
                            },
                            {
                                "type": "group",
                                "title": "Visibility",
                                "initialOpen": true,
                                "attributes": [
                                    {
                                        "id": "hide_xs",
                                        "type": "toggle",
                                        "label": "Hide at this breakpoint",
                                        "help": "Hides this block at this breakpoint and restores it at the next visible one."
                                    }
                                ]
                            }
                        ]
                    },
                    {
                        "id": "sm",
                        "title": "SM",
                        "attributes": [
                            {
                                "type": "message",
                                "value": "Small · Bootstrap infix sm"
                            },
                            {
                                "type": "group",
                                "title": "Visibility",
                                "initialOpen": true,
